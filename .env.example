# =====================================================================
# Local Coding Agent Stack - Configuration Template
# Copy this file to .env and adjust paths and settings.
# NEVER commit .env to version control!
# =====================================================================

# Server Ports & Hosts
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# llama.cpp Execution Configuration
# GGML_VK_PREFER_HOST_MEMORY=1 optimizes UMA integrated graphics (AMD Radeon 680M / 780M)
GGML_VK_PREFER_HOST_MEMORY=1
LLAMA_THREADS=12
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=99
LLAMA_FLASH_ATTN=1
LLAMA_KV_CACHE_TYPE_K=q8_0
LLAMA_KV_CACHE_TYPE_V=q8_0

# Model Paths
MODEL_PRIMARY_PATH=models/NeoHorse-1-4B-Q4_K_M.gguf
MODEL_FALLBACK_PATH=models/crowqwen3.5-4b-agent-heretic-q4_k_m.gguf
MODEL_MTP_DRAFTER_PATH=models/mtp-drafter.gguf

# LiteLLM / Proxy Configuration
ANTHROPIC_BASE_URL=http://127.0.0.1:4000
ANTHROPIC_API_KEY=local-dummy-key
ANTHROPIC_SMALL_FAST_MODEL=local-coding-agent
ANTHROPIC_DEFAULT_MODEL=local-coding-agent

# Claude Code CLI Configuration
CLAUDE_CODE_RETRY_COUNT=5
CLAUDE_CODE_TIMEOUT_SECONDS=120
CLAUDE_CODE_MAX_TURNS=30

# RSI (Recursive Self-Improvement) Loop Configuration
RSI_RAW_LOG_DIR=rsi_data/raw
RSI_CURATED_DIR=rsi_data/curated
RSI_CHECKPOINT_DIR=checkpoints
RSI_EVAL_BENCHMARK_SPLIT=0.2
RSI_MIN_LIFT_THRESHOLD=0.02
RSI_DAEMON_INTERVAL_SECONDS=86400
